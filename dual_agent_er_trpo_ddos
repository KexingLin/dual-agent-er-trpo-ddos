def homotopy_bohb_search(
    X_train: np.ndarray,
    y_train: np.ndarray,
    X_val: np.ndarray,
    y_val: np.ndarray,
    feature_names: Sequence[str],
    settings: FixedSettings,
    seed: int,
    working_dir: Path,
) -> Tuple[
    Dict,
    List[
        Dict
    ],
]:
    try:
        import hpbandster.core.nameserver as hpns

        from hpbandster.core.worker import Worker

        from hpbandster.optimizers import BOHB

    except ImportError as exc:
        raise ImportError(
            "HPBandSter is required for the paper BOHB pipeline. "
            "Install hpbandster==0.7.4."
        ) from exc

    config_space = build_configspace(
        seed
    )

    working_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    all_records: List[
        Dict
    ] = []

    previous_result = None
    final_result = None
    final_rho = 1.0

    class PaperWorker(
        Worker
    ):
        def __init__(
            self,
            *args,
            rho: float,
            **kwargs,
        ):
            super().__init__(
                *args,
                **kwargs,
            )

            self.rho = float(
                rho
            )

        def compute(
            self,
            config,
            budget,
            **kwargs,
        ):
            del kwargs

            candidate_config = dict(
                config
            )

            set_seed(
                seed
            )

           
            effective_epochs = min(
                int(
                    candidate_config[
                        "training_epochs"
                    ]
                ),
                max(
                    1,
                    int(
                        round(
                            float(
                                budget
                            )
                        )
                    ),
                ),
            )

            model = DualAgentFramework(
                X_train=X_train,
                y_train=y_train,
                X_val=X_val,
                y_val=y_val,
                feature_names=feature_names,
                config=candidate_config,
                settings=settings,
                seed=seed,
            )

            model.fit(
                effective_epochs,
                homotopy_rho=self.rho,
                verbose=False,
            )

            validation_probability, _ = model.predict(
                X_val,
                deterministic=True,
            )

            validation_ba = balanced_accuracy_score(
                y_val,
                (
                    validation_probability
                    >= 0.5
                ).astype(
                    int
                ),
            )

            loss = (
                1.0
                - float(
                    validation_ba
                )
            )

            info = {
                "balanced_accuracy": float(
                    validation_ba
                ),
                "rho": self.rho,
                "budget": float(
                    budget
                ),
                "effective_epochs": effective_epochs,
                "config": json_safe(
                    candidate_config
                ),
            }

            all_records.append(
                {
                    "loss": loss,
                    **info,
                }
            )

            return {
                "loss": loss,
                "info": info,
            }

    rho_values = np.linspace(
        0.0,
        1.0,
        settings.homotopy_stage_count,
    )

    for stage_index, rho in enumerate(
        rho_values
    ):
        run_id = (
            f"homotopy_{seed}_"
            f"{stage_index}_"
            f"{int(time.time() * 1e6) % 1000000}"
        )

        stage_dir = (
            working_dir
            / f"stage_{stage_index:02d}"
        )

        stage_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        nameserver = hpns.NameServer(
            run_id=run_id,
            host="127.0.0.1",
            port=0,
            working_directory=str(
                stage_dir
            ),
        )

        nameserver_host, nameserver_port = (
            nameserver.start()
        )

        worker = PaperWorker(
            rho=float(
                rho
            ),
            run_id=run_id,
            host="127.0.0.1",
            nameserver=nameserver_host,
            nameserver_port=nameserver_port,
            timeout=120,
        )

        worker.run(
            background=True
        )

        optimizer = BOHB(
            configspace=config_space,
            run_id=run_id,
            host="127.0.0.1",
            nameserver=nameserver_host,
            nameserver_port=nameserver_port,
            min_budget=settings.bohb_min_budget,
            max_budget=settings.bohb_max_budget,
            eta=settings.bohb_eta,
            previous_result=previous_result,
        )

        try:
            final_result = optimizer.run(
                n_iterations=settings.bohb_iterations_per_stage
            )

        finally:
            optimizer.shutdown(
                shutdown_workers=True
            )

            nameserver.shutdown()

        previous_result = (
            final_result
        )

        final_rho = float(
            rho
        )

    if final_result is None:
        raise RuntimeError(
            "Homotopy-BOHB did not produce a result."
        )

    id_to_config = (
        final_result
        .get_id2config_mapping()
    )

    candidate_runs = []

    for run in final_result.get_all_runs():
        info = (
            run.info
            or {}
        )

        if run.loss is None:
            continue

        if abs(
            float(
                info.get(
                    "rho",
                    -1.0,
                )
            )
            - final_rho
        ) < 1e-12:
            candidate_runs.append(
                run
            )

    if not candidate_runs:
        incumbent_id = (
            final_result
            .get_incumbent_id()
        )

        best_config = dict(
            id_to_config[
                incumbent_id
            ][
                "config"
            ]
        )

    else:
        maximum_budget = max(
            float(
                run.budget
            )
            for run in candidate_runs
        )

        high_budget_runs = [
            run
            for run in candidate_runs
            if abs(
                float(
                    run.budget
                )
                - maximum_budget
            ) < 1e-12
        ]

        best_run = min(
            high_budget_runs,
            key=lambda run: float(
                run.loss
            ),
        )

        best_config = dict(
            id_to_config[
                best_run.config_id
            ][
                "config"
            ]
        )

    with open(
        working_dir
        / "bohb_records.json",
        "w",
        encoding="utf-8",
    ) as output_file:
        json.dump(
            json_safe(
                all_records
            ),
            output_file,
            indent=2,
        )

    with open(
        working_dir
        / "best_config.json",
        "w",
        encoding="utf-8",
    ) as output_file:
        json.dump(
            json_safe(
                best_config
            ),
            output_file,
            indent=2,
        )

    return (
        best_config,
        all_records,
    )


def aggregate_runs(
    run_metrics: List[
        Dict[
            str,
            float,
        ]
    ],
) -> Dict[
    str,
    Dict[
        str,
        float,
    ],
]:
    scalar_keys = [
        "accuracy",
        "sensitivity",
        "f_measure",
        "balanced_accuracy",
        "mcc",
        "precision",
        "specificity",
        "fpr",
        "fnr",
        "roc_auc",
        "pr_auc",
        "mean_selected_features",
        "annotation_count",
        "final_labeled_size",
    ]

    result = {}

    for key in scalar_keys:
        values = np.asarray(
            [
                metric[
                    key
                ]
                for metric in run_metrics
                if (
                    key in metric
                    and np.isfinite(
                        metric[
                            key
                        ]
                    )
                )
            ],
            dtype=float,
        )

        if len(
            values
        ):
            result[
                key
            ] = {
                "mean": float(
                    values.mean()
                ),
                "std": (
                    float(
                        values.std(
                            ddof=1
                        )
                    )
                    if len(values) > 1
                    else 0.0
                ),
                "values": values.tolist(),
            }

    return result


def holm_bonferroni(
    p_values: Dict[
        str,
        float,
    ],
    alpha: float = 0.05,
) -> Dict[
    str,
    Dict[
        str,
        float,
    ],
]:
    items = sorted(
        p_values.items(),
        key=lambda item: item[1],
    )

    total_tests = len(
        items
    )

    adjusted = {}
    running_maximum = 0.0

    for rank, (
        name,
        p_value,
    ) in enumerate(
        items,
        start=1,
    ):
        adjusted_p = min(
            1.0,
            (
                total_tests
                - rank
                + 1
            )
            * p_value,
        )

        running_maximum = max(
            running_maximum,
            adjusted_p,
        )

        adjusted[
            name
        ] = {
            "raw_p": float(
                p_value
            ),
            "holm_adjusted_p": float(
                running_maximum
            ),
            "significant": bool(
                running_maximum
                < alpha
            ),
        }

    return adjusted


def paired_statistical_analysis(
    proposed_metrics: List[
        Dict[
            str,
            float,
        ]
    ],
    baseline_results_path: str,
    alpha: float = 0.05,
) -> Dict:
    with open(
        baseline_results_path,
        "r",
        encoding="utf-8",
    ) as input_file:
        baselines = json.load(
            input_file
        )

    output = {}

    metric_names = [
        "accuracy",
        "sensitivity",
        "f_measure",
        "balanced_accuracy",
        "mcc",
    ]

    for metric in metric_names:
        proposed = np.asarray(
            [
                result[
                    metric
                ]
                for result in proposed_metrics
            ],
            dtype=float,
        )

        p_values = {}
        test_values = {}

        for baseline_name, baseline_data in baselines.items():
            if metric not in baseline_data:
                continue

            baseline = np.asarray(
                baseline_data[
                    metric
                ],
                dtype=float,
            )

            if len(
                baseline
            ) != len(
                proposed
            ):
                raise ValueError(
                    f"Baseline '{baseline_name}' metric '{metric}' "
                    f"has {len(baseline)} runs; the proposed model "
                    f"has {len(proposed)} runs."
                )

            differences = (
                proposed
                - baseline
            )

            mean_difference = float(
                np.mean(
                    differences
                )
            )

            sd_difference = (
                float(
                    np.std(
                        differences,
                        ddof=1,
                    )
                )
                if len(
                    differences
                ) > 1
                else 0.0
            )

            t_statistic, p_value = ttest_rel(
                proposed,
                baseline,
                alternative="two-sided",
            )

            p_values[
                baseline_name
            ] = float(
                p_value
            )

            if sd_difference > 0:
                cohens_d = (
                    mean_difference
                    / sd_difference
                )

            elif mean_difference > 0:
                cohens_d = float(
                    "inf"
                )

            elif mean_difference < 0:
                cohens_d = float(
                    "-inf"
                )

            else:
                cohens_d = 0.0

            test_values[
                baseline_name
            ] = {
                "t_statistic": float(
                    t_statistic
                ),
                "mean_difference": mean_difference,
                "sd_difference": sd_difference,
                "cohens_d": float(
                    cohens_d
                ),
            }

            if len(
                differences
            ) > 1:
                critical_value = float(
                    student_t.ppf(
                        0.975,
                        df=(
                            len(
                                differences
                            )
                            - 1
                        ),
                    )
                )

                half_width = (
                    critical_value
                    * sd_difference
                    / math.sqrt(
                        len(
                            differences
                        )
                    )
                )

                test_values[
                    baseline_name
                ][
                    "ci95_low"
                ] = (
                    mean_difference
                    - half_width
                )

                test_values[
                    baseline_name
                ][
                    "ci95_high"
                ] = (
                    mean_difference
                    + half_width
                )

            else:
                test_values[
                    baseline_name
                ][
                    "ci95_low"
                ] = float(
                    "nan"
                )

                test_values[
                    baseline_name
                ][
                    "ci95_high"
                ] = float(
                    "nan"
                )

        corrected = holm_bonferroni(
            p_values,
            alpha=alpha,
        )

        for baseline_name in corrected:
            corrected[
                baseline_name
            ].update(
                test_values[
                    baseline_name
                ]
            )

        output[
            metric
        ] = corrected

    return output


def parse_seed_list(
    text: str,
) -> List[int]:
    values = [
        int(
            value.strip()
        )
        for value in text.split(
            ","
        )
        if value.strip()
    ]

    if not values:
        raise ValueError(
            "At least one random seed is required."
        )

    return values


def run_one_seed(
    X_raw: pd.DataFrame,
    y: np.ndarray,
    seed: int,
    settings: FixedSettings,
    output_dir: Path,
    run_hpo: bool,
    fixed_config_path: Optional[
        str
    ],
) -> Dict[
    str,
    float,
]:
    set_seed(
        seed
    )

    (
        X_train_raw,
        X_val_raw,
        X_test_raw,
        y_train,
        y_val,
        y_test,
    ) = stratified_split_raw(
        X_raw,
        y,
        seed,
    )

    preprocessor = LeakageSafePreprocessor(
        settings.clip_lower_quantile,
        settings.clip_upper_quantile,
    )

    X_train = preprocessor.fit_transform(
        X_train_raw
    )

    X_val = preprocessor.transform(
        X_val_raw
    )

    X_test = preprocessor.transform(
        X_test_raw
    )

    feature_names = (
        preprocessor
        .get_feature_names()
    )

    seed_dir = (
        output_dir
        / f"seed_{seed}"
    )

    seed_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    if run_hpo:
        best_config, _ = homotopy_bohb_search(
            X_train=X_train,
            y_train=y_train,
            X_val=X_val,
            y_val=y_val,
            feature_names=feature_names,
            settings=settings,
            seed=seed,
            working_dir=(
                seed_dir
                / "homotopy_bohb"
            ),
        )

    else:
        if not fixed_config_path:
            raise ValueError(
                "--skip-hpo requires --fixed-config containing a "
                "previously optimized configuration."
            )

        with open(
            fixed_config_path,
            "r",
            encoding="utf-8",
        ) as input_file:
            best_config = json.load(
                input_file
            )

    final_model = DualAgentFramework(
        X_train=X_train,
        y_train=y_train,
        X_val=X_val,
        y_val=y_val,
        feature_names=feature_names,
        config=best_config,
        settings=settings,
        seed=seed,
    )

  
    final_epochs = int(
        best_config[
            "training_epochs"
        ]
    )

    final_model.fit(
        final_epochs,
        homotopy_rho=1.0,
        verbose=False,
    )

    test_metrics = final_model.evaluate(
        X_test,
        y_test,
    )

    test_metrics[
        "seed"
    ] = seed

    final_model.save(
        seed_dir,
        preprocessor,
        test_metrics,
    )

    with open(
        seed_dir
        / "best_config.json",
        "w",
        encoding="utf-8",
    ) as output_file:
        json.dump(
            json_safe(
                best_config
            ),
            output_file,
            indent=2,
        )

    return test_metrics


