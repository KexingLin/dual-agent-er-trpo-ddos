        default=3,
    )

    parser.add_argument(
        "--bohb-eta",
        type=int,
        default=3,
    )

    parser.add_argument(
        "--lime-num-samples",
        type=int,
        default=512,
    )

    parser.add_argument(
        "--lime-kernel-width",
        type=float,
        default=None,
    )

    parser.add_argument(
        "--validation-reward-max-samples",
        type=int,
        default=None,
    )

    parser.add_argument(
        "--device",
        default=(
            "cuda"
            if torch.cuda.is_available()
            else "cpu"
        ),
    )

    return parser


def main() -> None:
    args = (
        build_arg_parser()
        .parse_args()
    )

    output_dir = Path(
        args.output_dir
    )

    output_dir.mkdir(
        parents=True,
        exist_ok=True,
    )
    settings = FixedSettings(
        clip_lower_quantile=args.clip_lower_quantile,
        clip_upper_quantile=args.clip_upper_quantile,
        initial_labeled_fraction=args.initial_labeled_fraction,
        lstm_hidden_size=args.lstm_hidden_size,
        policy_hidden_size=args.policy_hidden_size,
        value_hidden_size=args.value_hidden_size,
        gamma=args.gamma,
        n_step=args.n_step,
        kl_delta=args.kl_delta,
        cg_iterations=args.cg_iterations,
        cg_damping=args.cg_damping,
        line_search_steps=args.line_search_steps,
        line_search_backtrack=args.line_search_backtrack,
        value_iterations=args.value_iterations,
        detector_update_epochs_after_annotation=(
            args.detector_update_epochs_after_annotation
        ),
        homotopy_stage_count=args.homotopy_stage_count,
        bohb_iterations_per_stage=args.bohb_iterations_per_stage,
        bohb_eta=args.bohb_eta,
        lime_num_samples=args.lime_num_samples,
        lime_kernel_width=args.lime_kernel_width,
        validation_reward_max_samples=(
            args.validation_reward_max_samples
        ),
        device=args.device,
    )

    data_path = Path(
        args.data_path
    )

    aligned_path = run_cicflowmeter_if_needed(
        data_path=data_path,
        command_template=args.cicflowmeter_command,
        output_dir=(
            output_dir
            / "cicflowmeter_flows"
        ),
    )

    dataframe = load_raw_dataset(
        str(
            aligned_path
        ),
        max_rows=args.max_rows,
    )

    label_column = infer_label_column(
        dataframe,
        args.label_column,
    )

    X_raw, y = clean_dataset(
        dataframe,
        label_column,
    )

    seeds = parse_seed_list(
        args.seeds
    )

    with open(
        output_dir
        / "run_settings.json",
        "w",
        encoding="utf-8",
    ) as output_file:
        json.dump(
            json_safe(
                {
                    "dataset": args.dataset,
                    "data_path": str(
                        data_path
                    ),
                    "label_column": str(
                        label_column
                    ),
                    "seeds": seeds,
                    "fixed_settings": asdict(
                        settings
                    ),
                    "paper_search_space": PAPER_SEARCH_SPACE,
                }
            ),
            output_file,
            indent=2,
        )

    run_metrics = []

    for seed in seeds:
        metrics = run_one_seed(
            X_raw=X_raw,
            y=y,
            seed=seed,
            settings=settings,
            output_dir=output_dir,
            run_hpo=(
                not args.skip_hpo
            ),
            fixed_config_path=args.fixed_config,
        )

        run_metrics.append(
            metrics
        )

        print(
            f"Seed {seed}: "
            f"{json.dumps(json_safe(metrics), sort_keys=True)}"
        )

    aggregate = aggregate_runs(
        run_metrics
    )

    with open(
        output_dir
        / "aggregate_metrics.json",
        "w",
        encoding="utf-8",
    ) as output_file:
        json.dump(
            json_safe(
                aggregate
            ),
            output_file,
            indent=2,
        )

    print(
        "\nMean ± standard deviation across independent runs:"
    )

    for metric, statistics in aggregate.items():
        print(
            f"{metric}: "
            f"{statistics['mean']:.6f} "
            f"± "
            f"{statistics['std']:.6f}"
        )

    if args.baseline_results:
        statistical_results = paired_statistical_analysis(
            run_metrics,
            args.baseline_results,
            alpha=0.05,
        )

        with open(
            output_dir
            / "paired_statistics_holm.json",
            "w",
            encoding="utf-8",
        ) as output_file:
            json.dump(
                json_safe(
                    statistical_results
                ),
                output_file,
                indent=2,
            )

        print(
            "Paired two-sided t-tests, 95% confidence intervals, "
            "Cohen's d values, and Holm-Bonferroni-adjusted p-values "
            "were saved to paired_statistics_holm.json"
        )


if __name__ == "__main__":
    main()
